# A testnet build of the web app (D30, ADR-0021): NEAR testnet, Base Sepolia and Arbitrum Sepolia.
# Every value the build reads comes from the network table (lib/network.ts); this one setting
# picks the row. `next build` with only this file's variables, the project ID below filled in,
# builds the testnet site (e2e/build.spec.ts checks). Leave it unset for mainnet; any other
# value fails the build.
NEXT_PUBLIC_NETWORK=testnet

# Required by every build, mainnet's too (D36, ADR-0022): the WalletConnect project ID from
# Reown's dashboard, which the wallet picker needs for MetaMask Mobile's QR code. `next build`
# fails while it is unset or empty. Keep it in an ignored env file (web/.env.local), never here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. The site's own address, for absolute social-card image links (Vercel sets its own).
# NEXT_PUBLIC_SITE_URL=

# Optional. The mainnet site's address, e.g. https://bountee.xyz: the Testnet badge links to it
# and the nav's Verify link to its Verify section (D31). Unset, the badge is plain text and the
# nav has no Verify link. (A mainnet build links back with NEXT_PUBLIC_TESTNET_SITE.)
# NEXT_PUBLIC_MAINNET_SITE=

# Optional overrides, each winning over the table; unset, the table's public endpoint is used.
# Read by the server at request time:
# NEAR_RPC=
# NEAR_ARCHIVAL_RPC=
# TX_API=
# OUTLAYER_API=
# BOUNTY_CONTRACT=
# NEAR_ETH_RPC=
# EVM_RPC_84532=
# EVM_RPC_421614=
# Fixed into the browser when the site is built:
# NEXT_PUBLIC_BOUNTY_CONTRACT=
# NEXT_PUBLIC_NEAR_USDC=
# NEXT_PUBLIC_NEAR_ETH_RPC=
# NEXT_PUBLIC_EVM_RPC_84532=
# NEXT_PUBLIC_EVM_RPC_421614=
# NEXT_PUBLIC_NEAR_FAUCET=
